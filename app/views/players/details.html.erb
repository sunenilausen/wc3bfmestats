<% content_for :title, "#{@player.nickname} - Advanced Stats" %>

<div class="w-full">
  <h1 class="font-bold text-4xl"><%= @player.nickname %> <span class="text-gray-400 font-normal">Advanced Stats</span></h1>

  <div class="w-full sm:w-auto my-5 space-y-5">
    <div class="mb-4 flex flex-wrap items-center gap-4">
      <%= link_to "Back to player", player_path(@player), class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>

      <%= form_with url: details_player_path(@player), method: :get, local: true, class: "flex flex-wrap items-center gap-4" do %>
        <div class="flex items-center gap-2">
          <label for="version_filter" class="text-sm text-gray-600">Stats:</label>
          <select name="version_filter" id="version_filter" onchange="this.form.submit()" class="rounded-md border border-gray-300 px-3 py-1.5 text-sm">
            <option value="">All versions</option>
            <% @available_map_versions.each do |version| %>
              <option value="from:<%= version %>" <%= "selected" if @version_filter == "from:#{version}" %>>from <%= version %></option>
            <% end %>
            <optgroup label="Single version">
              <% @available_map_versions.each do |version| %>
                <option value="only:<%= version %>" <%= "selected" if @version_filter == "only:#{version}" %>>only <%= version %></option>
              <% end %>
            </optgroup>
          </select>
        </div>
      <% end %>
    </div>

    <% if @map_version.present? %>
      <div class="mb-4 px-3 py-2 bg-blue-50 border border-blue-200 rounded-md text-sm text-blue-700">
        Showing stats for <strong><%= @map_version %></strong> only
        &mdash; <%= link_to "Show all versions", details_player_path(@player), class: "underline hover:no-underline" %>
      </div>
    <% elsif @map_version_until.present? %>
      <div class="mb-4 px-3 py-2 bg-blue-50 border border-blue-200 rounded-md text-sm text-blue-700">
        Showing stats from <strong><%= @map_version_until %></strong> onwards (<%= @filtered_map_versions.size %> versions)
        &mdash; <%= link_to "Show all versions", details_player_path(@player), class: "underline hover:no-underline" %>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <%# Hosting Statistics %>
      <div class="bg-gray-50 rounded-md p-3">
        <h3 class="font-semibold mb-2 text-gray-700">Hosting Statistics</h3>
        <% if @hosting_stats %>
          <table class="w-full text-sm">
            <tbody>
              <tr>
                <td class="py-0.5" title="Games where this player was the lobby host">Games Hosted</td>
                <td class="text-right py-0.5">
                  <span class="font-medium"><%= @hosting_stats[:total] %></span>
                  <% if @hosting_stats[:not_played] > 0 %>
                    <span class="text-gray-500 text-xs">(<%= @hosting_stats[:not_played] %> without playing)</span>
                  <% end %>
                </td>
              </tr>
              <tr>
                <td class="py-0.5" title="Hosted games with a 45-55% predicted win chance for either team">Balanced Lobbies</td>
                <td class="text-right py-0.5">
                  <% if @hosting_stats[:predicted] > 0 %>
                    <span class="font-medium"><%= @hosting_stats[:balanced] %></span>/<%= @hosting_stats[:predicted] %>
                    <span class="text-teal-600 font-medium">(<%= @hosting_stats[:balanced_pct] %>%)</span>
                  <% else %>
                    -
                  <% end %>
                </td>
              </tr>
              <tr>
                <td class="py-0.5" title="Win/loss record in games this player hosted and played in">Record as Host</td>
                <td class="text-right py-0.5">
                  <span class="text-green-600 font-medium"><%= @hosting_stats[:wins] %>W</span>/<span class="text-red-600 font-medium"><%= @hosting_stats[:losses] %>L</span>
                  <% if @hosting_stats[:win_pct] %>
                    <span class="text-gray-500">(<%= @hosting_stats[:win_pct] %>%)</span>
                  <% end %>
                </td>
              </tr>
              <%
                role_rows = [
                  [ :favorite, "As Favorite", "Win rate when the host's team had >55% predicted win chance", "text-orange-600" ],
                  [ :balanced, "As Balanced", "Win rate when the host's team had 45-55% predicted win chance", "text-teal-600" ],
                  [ :underdog, "As Underdog", "Win rate when the host's team had <45% predicted win chance", "text-purple-600" ]
                ]
              %>
              <% role_rows.each do |role, label, tooltip, color| %>
                <% role_wins, role_losses = @hosting_stats[:record_by_role][role] %>
                <% role_games = role_wins + role_losses %>
                <tr>
                  <td class="py-0.5" title="<%= tooltip %>"><%= label %></td>
                  <td class="text-right py-0.5">
                    <% if role_games > 0 %>
                      <span class="text-green-600 font-medium"><%= role_wins %>W</span>/<span class="text-red-600 font-medium"><%= role_losses %>L</span>
                      <span class="<%= color %> font-medium">(<%= (role_wins.to_f / role_games * 100).round(1) %>%)</span>
                    <% else %>
                      -
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-sm text-gray-500">No hosted games recorded.</p>
        <% end %>
      </div>

      <%# Lobby Balance Brackets %>
      <% if @hosting_stats && @hosting_stats[:predicted] > 0 %>
        <div class="bg-gray-50 rounded-md p-3">
          <h3 class="font-semibold mb-2 text-gray-700">Lobby Balance</h3>
          <p class="text-xs text-gray-500 mb-2">Predicted win chance of the favored team in hosted games. 50-55% = even match, 95-100% = heavily one-sided.</p>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b">
                <th class="text-left py-1 font-medium text-gray-600">Prediction</th>
                <th class="text-right py-1 font-medium text-gray-600">Games</th>
                <th class="text-right py-1 font-medium text-gray-600">Share</th>
              </tr>
            </thead>
            <tbody>
              <% @hosting_stats[:brackets].each do |bracket| %>
                <tr class="border-b border-gray-100">
                  <td class="py-1"><%= bracket[:label] %>%</td>
                  <td class="text-right py-1"><%= bracket[:count] %></td>
                  <td class="text-right py-1 text-gray-500"><%= bracket[:pct] %>%</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>
